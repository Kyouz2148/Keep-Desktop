{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Keep",
  "version": "0.1.1",
  "identifier": "com.kyouztech.keepdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Google Keep",
        "url": "index.html",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "center": true,
        "devtools": true,
        "backgroundColor": "#202124",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,ServiceWorkerStaticRouter,ThirdPartyStoragePartitioning,TrackingProtection3pcd"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
