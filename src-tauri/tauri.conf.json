{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Keep",
  "version": "0.2.6",
  "identifier": "com.kyouztech.keepdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Aplicativo desktop leve para o Google Keep",
    "longDescription": "Cliente desktop para o Google Keep com bandeja do sistema, atalhos globais, controle de zoom e persistencia.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
