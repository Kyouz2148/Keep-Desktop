{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Google Keep",
  "version": "0.1.0",
  "identifier": "com.kyouztech.keepdesktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Google Keep",
        "url": "https://keep.google.com",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
